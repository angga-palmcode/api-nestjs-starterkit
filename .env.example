# Copy to .env for local development. Every variable is validated at boot
# (src/config/env.schema.ts); the app refuses to start if one is invalid.

NODE_ENV=development
PORT=3000

# Shown in Swagger
APP_NAME=Nest Starter Kit
APP_VERSION=0.1.0
APP_DESCRIPTION=REST API

# Swagger UI at /docs. Unset = enabled except in production.
# SWAGGER_ENABLED=true
# Optional basic auth for /docs (set both; password >= 8 chars)
# SWAGGER_USER=docs
# SWAGGER_PASSWORD=change-me-please

# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
# json | pretty  (default: json in production, pretty otherwise)
LOG_FORMAT=pretty

# Express "trust proxy": true | false | <hop count> | loopback ... (set to the
# number of proxies in front of the app in production, e.g. 1)
TRUST_PROXY=false

# Comma-separated CORS allow-list. Empty = CORS disabled. "*" is rejected.
CORS_ORIGINS=http://localhost:5173

# Force-exit if graceful shutdown takes longer than this (0 = never)
SHUTDOWN_TIMEOUT_MS=10000

# ── Auth ────────────────────────────────────────────────────────────────────
# password | password,otp   (adds passwordless email-code login)
AUTH_METHODS=password
# none | totp | otp          (second factor after the primary login)
AUTH_MFA=none
# Block login until the email is verified (invited users are verified on accept)
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Open self-registration. Default: invite-only.
AUTH_ALLOW_REGISTRATION=false
# Re-check is_active / role / token_version / session in the DB on every request
AUTH_VERIFY_USER_PER_REQUEST=true
# console (dev: prints codes/links) | email (needs an EMAIL_TRANSPORT provider)
AUTH_DELIVERY=console
# Three DIFFERENT secrets, >= 32 chars each. Generate: openssl rand -base64 48
# ("change-me..." values are rejected in production)
AUTH_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
AUTH_MFA_CHALLENGE_SECRET=change-me-challenge-secret-at-least-32-chars
AUTH_EMAIL_VERIFY_SECRET=change-me-email-verify-secret-at-least-32-chars
# Required when AUTH_MFA=totp. Generate: openssl rand -base64 32
# AUTH_MFA_ENCRYPTION_KEY=
# bcrypt cost (12 = sound default; lower only in tests)
AUTH_BCRYPT_ROUNDS=12
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=7
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_RESET_TTL_MINUTES=60
AUTH_EMAIL_VERIFY_TTL_HOURS=24

# Throttling (in-memory). Sensitive auth endpoints have stricter built-in limits.
THROTTLE_ENABLED=true
THROTTLE_LIMIT=100
THROTTLE_TTL_SECONDS=60

# Required. Matches docker-compose.yml.
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public

# Frontend base URL for links in emails (invitations)
FRONTEND_URL=http://localhost:5173
# Invitation link validity
INVITATION_TTL_HOURS=72

# Seed (npm run seed). Superadmin is required; admin/user demo accounts only when set.
# Passwords: >= 12 chars. Existing users are never overwritten unless SEED_RESET_PASSWORDS=true.
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
# SEED_USER_EMAIL=user@example.com
# SEED_USER_PASSWORD=

# Optional, off by default. REDIS_URL is the only switch: unset = no Redis client and rate limits are
# counted in memory per instance; set = rate-limit counters are shared between instances (needs src/redis).
# Redis FAILS OPEN: if it is down, each instance falls back to counting in memory.
# To try it locally: `docker compose up -d`, then uncomment the next line.
# REDIS_URL=redis://localhost:6379

# ── Optional modules ───────────────────────────────────────────────────────────
# Mail (src/mail): console (dev, prints subjects) | smtp (nodemailer)
MAIL_TRANSPORT=console
# MAIL_FROM="My App <no-reply@example.com>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# To send auth emails through it: AUTH_DELIVERY=email

# Storage (src/storage): local (directory) | s3 (S3-compatible)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-data
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=            # MinIO / Backblaze B2 / R2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Jobs (src/jobs): enable on EXACTLY ONE instance
ENABLE_CRON=false
JOBS_RETENTION_DAYS=30
